# SHRINEVA — Hostinger (Apache / LiteSpeed) rules for the static Angular build.
# Domain-agnostic: nothing here names the domain, so it works unchanged for shrineva.in or any alias.

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 2. www -> apex (any domain)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 2b. Old URLs from earlier versions of the site: permanent (301) redirects to their merged pages. Placed before the file
#     rules so they also work if an old folder is still on the server. Remove the old folders when you upload the new build.
RewriteRule ^(location|contact)/?$ https://%{HTTP_HOST}/location-contact [R=301,L]
RewriteRule ^(privacy|disclaimer)/?$ https://%{HTTP_HOST}/privacy-disclaimer [R=301,L]
RewriteRule ^(property|business-fit)/?$ https://%{HTTP_HOST}/ [R=301,L]
RewriteRule ^(spaces|spaces/floor-[1-3]|infrastructure)/?$ https://%{HTTP_HOST}/floor-plans [R=301,L]
RewriteRule ^growth/?$ https://%{HTTP_HOST}/location-contact [R=301,L]
RewriteRule ^gallery/?$ https://%{HTTP_HOST}/walkthrough [R=301,L]
RewriteRule ^brokers/?$ https://%{HTTP_HOST}/leasing [R=301,L]

# 3a. /floor-plans (no slash) serves /floor-plans/index.html directly, so the URL matches the canonical (no 301 to /floor-plans/)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ $1/index.html [L]

# 3. Real files and folders are served as they are (including the per-route SEO shells such as /floor-plans/)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4. Known app routes fall back to the app if their static folder is missing. Anything else is a real 404
#    (see ErrorDocument below), so crawlers do not index junk URLs as copies of the home page.
#    Keep this list in step with src/app/config/seo.config.ts; `npm run build` fails if a route is missing.
RewriteRule ^(floor-plans|walkthrough|location-contact|healthcare-diagnostic-space|office-bank-coaching-space|retail-showroom-cafe-space|leasing|hi|privacy-disclaimer|terms)/?$ index.html [L]
</IfModule>

# Unknown URLs: real 404 status with the app shell (404.html), which sends visitors to the home page.
ErrorDocument 404 /404.html

# Compression: Brotli where the host has it (LiteSpeed does this on its own for clients that accept it), gzip otherwise
<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml font/ttf
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml font/ttf
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(html|css|js|json|xml|txt|svg)$">
Header append Vary Accept-Encoding
</FilesMatch>
# The brochure and plan PDFs are handed out through the enquiry form (name, mobile number and email): keep them out of search results.
# Delete this block if you would rather let Google index the PDFs.
<FilesMatch "\.pdf$">
Header set X-Robots-Tag "noindex, noarchive"
</FilesMatch>
</IfModule>

# Browser caching: hashed JS/CSS/fonts never change under the same name; HTML must revalidate.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType application/xml "access plus 1 day"
ExpiresByType text/plain "access plus 1 day"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType font/woff "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType application/pdf "access plus 1 week"
</IfModule>

# Security headers (no inline-script CSP yet: Angular injects inline styles; see README)
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
<FilesMatch "\.(html)$">
Header set Cache-Control "no-cache"
</FilesMatch>
# Angular's hashed bundles (main.<16 hex>.js, styles.<16 hex>.css) never change under the same name, and fonts rarely do.
<FilesMatch "\.[0-9a-f]{16}\.(js|css)$|\.woff2?$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
# HTTPS only: browsers remember this for 180 days (the redirect above already sends everyone to HTTPS).
Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
</IfModule>

# Plain-text files for crawlers and AI assistants are served as UTF-8 text (Hindi text in llms-full.txt must not turn into mojibake)
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
<FilesMatch "^(robots|llms|llms-full)\.txt$">
Header set Content-Type "text/plain; charset=utf-8"
</FilesMatch>
</IfModule>

# Do not list folders
Options -Indexes
