{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/shrineva",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/location",
      "destination": "/location-contact",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/location-contact",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy-disclaimer",
      "permanent": true
    },
    {
      "source": "/disclaimer",
      "destination": "/privacy-disclaimer",
      "permanent": true
    },
    {
      "source": "/property",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/business-fit",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/spaces",
      "destination": "/floor-plans",
      "permanent": true
    },
    {
      "source": "/spaces/:floorId",
      "destination": "/floor-plans",
      "permanent": true
    },
    {
      "source": "/infrastructure",
      "destination": "/floor-plans",
      "permanent": true
    },
    {
      "source": "/growth",
      "destination": "/location-contact",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/walkthrough",
      "permanent": true
    },
    {
      "source": "/brokers",
      "destination": "/leasing",
      "permanent": true
    }
  ]
}
